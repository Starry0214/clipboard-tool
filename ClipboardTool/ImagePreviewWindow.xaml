<Window x:Class="ClipboardTool.ImagePreviewWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="图片预览"
        Width="720" Height="540"
        MinWidth="360" MinHeight="300"
        WindowStartupLocation="CenterScreen"
        Background="#1F1F1F"
        Icon="{StaticResource AppIcon}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- 顶部工具栏 -->
        <Border Grid.Row="0" Background="#2B2B2B" Padding="12,8">
            <DockPanel>
                <TextBlock x:Name="TitleText" DockPanel.Dock="Left"
                           FontSize="13" Foreground="#CCCCCC" VerticalAlignment="Center"/>
                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                    <Button x:Name="BtnFit" Content="适应窗口" Style="{StaticResource FluentButtonSecondary}"
                            Padding="12,4" Margin="0,0,8,0" FontSize="12" Click="OnFit"/>
                    <Button x:Name="BtnActual" Content="实际大小" Style="{StaticResource FluentButtonSecondary}"
                            Padding="12,4" FontSize="12" Click="OnActual"/>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 图片区域（深色背景 + 滚动 + 缩放） -->
        <Border Grid.Row="1" Background="#1A1A1A" ClipToBounds="True">
            <ScrollViewer x:Name="Scroller" HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Auto">
                <Grid>
                    <Image x:Name="PreviewImage"
                           Stretch="Uniform"
                           SnapsToDevicePixels="True"
                           RenderOptions.BitmapScalingMode="HighQuality"/>
                    <!-- 空状态提示 -->
                    <TextBlock x:Name="EmptyHint" Text="无图片内容"
                               Foreground="#666666" FontSize="14"
                               HorizontalAlignment="Center" VerticalAlignment="Center"
                               Visibility="Collapsed"/>
                </Grid>
            </ScrollViewer>
        </Border>
    </Grid>
</Window>
