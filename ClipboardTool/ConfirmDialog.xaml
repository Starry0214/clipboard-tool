<Window x:Class="ClipboardTool.ConfirmDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="确认"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBgBrush}"
        Icon="{StaticResource AppIcon}">
    <Border Background="{StaticResource CardBrush}"
            BorderBrush="{StaticResource CardBorderBrush}"
            BorderThickness="1" CornerRadius="10" Margin="14">
        <StackPanel Margin="18">
            <StackPanel Orientation="Horizontal" Margin="0,0,0,14">
                <!-- 警示/信息图标 -->
                <Border x:Name="IconCircle" Width="40" Height="40" CornerRadius="20"
                        VerticalAlignment="Top">
                    <TextBlock x:Name="IconText"
                               FontFamily="Segoe MDL2 Assets" FontSize="20"
                               Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                </Border>
                <StackPanel Margin="12,0,0,0" VerticalAlignment="Center">
                    <TextBlock x:Name="TitleText"
                               FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}"/>
                    <TextBlock x:Name="SubtitleText" FontSize="12"
                               Foreground="{StaticResource TextMutedBrush}" Margin="0,2,0,0"/>
                </StackPanel>
            </StackPanel>
            <TextBlock x:Name="MessageText" FontSize="13" LineHeight="20"
                       Foreground="{StaticResource TextPrimaryBrush}"
                       TextWrapping="Wrap" Margin="0,0,0,18"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="取消" Style="{StaticResource FluentButtonSecondary}"
                        Padding="16,7" IsCancel="True"/>
                <Button x:Name="ConfirmBtn" Padding="16,7" Margin="10,0,0,0"
                        Click="OnConfirm"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
