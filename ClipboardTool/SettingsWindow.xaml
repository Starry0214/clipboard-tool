<Window x:Class="ClipboardTool.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="400" Height="420"
        MinWidth="360" MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        Background="#F3F3F3"
        Icon="{StaticResource AppIcon}">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <ScrollViewer Grid.Row="0" VerticalScrollBarVisibility="Auto">
            <StackPanel Margin="0,0,8,0">
                <TextBlock Text="全局热键" FontWeight="SemiBold" Foreground="#1A1A1A" Margin="0,0,0,6"/>
                <CheckBox x:Name="WinVCheck" Content="启用 Win+V 覆盖（接管系统剪贴板历史）"
                          Style="{StaticResource FluentCheckBox}" Margin="0,0,0,4"/>
                <Border x:Name="WinVHintBox" Background="#E8F0FE" CornerRadius="6" Padding="10,8"
                        Margin="0,0,0,10" Visibility="Collapsed">
                    <TextBlock Text="已启用 Win+V 覆盖模式：快捷键固定为 Win+V，系统剪贴板历史将被自动接管，无需手动关闭系统设置，也无需修改下方快捷键。"
                               FontSize="12" Foreground="#0078D4" TextWrapping="Wrap" LineHeight="18"/>
                </Border>
                <TextBlock Text="自定义快捷键" FontSize="12" Foreground="#888888" Margin="0,0,0,4"/>
                <TextBox x:Name="HotkeyBox" Style="{StaticResource FluentTextBox}" Margin="0,0,0,16"/>

                <TextBlock Text="历史条数上限" FontWeight="SemiBold" Foreground="#1A1A1A" Margin="0,0,0,6"/>
                <TextBlock Text="范围 10 ~ 10000" FontSize="12" Foreground="#888888" Margin="0,0,0,4"/>
                <TextBox x:Name="MaxBox" Style="{StaticResource FluentTextBox}" Margin="0,0,0,16"/>

                <TextBlock Text="悬浮列表高度" FontWeight="SemiBold" Foreground="#1A1A1A" Margin="0,0,0,6"/>
                <TextBlock Text="像素，0 = 按屏幕高度自动适配（70%）" FontSize="12" Foreground="#888888" Margin="0,0,0,4"/>
                <TextBox x:Name="OverlayHeightBox" Style="{StaticResource FluentTextBox}" Margin="0,0,0,16"/>

                <TextBlock Text="启动与粘贴选项" FontWeight="SemiBold" Foreground="#1A1A1A" Margin="0,0,0,8"/>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,8">
                    <StackPanel Margin="4">
                        <CheckBox x:Name="AutoStartCheck" Content="开机自动启动" Style="{StaticResource FluentCheckBox}"/>
                        <CheckBox x:Name="StartMenuCheck" Content="添加到开始菜单" Style="{StaticResource FluentCheckBox}" Margin="0,6,0,0"/>
                        <CheckBox x:Name="PlainCheck" Content="粘贴时默认去格式（纯文本）" Style="{StaticResource FluentCheckBox}" Margin="0,6,0,0"/>
                    </StackPanel>
                </Border>

                <TextBlock Text="数据目录" FontWeight="SemiBold" Foreground="#1A1A1A" Margin="0,0,0,6"/>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,4">
                    <StackPanel Margin="4">
                        <TextBlock Text="历史记录与设置保存在独立数据目录，更新/覆盖程序不会丢失内容。"
                                   FontSize="12" Foreground="#888888" TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,6"/>
                        <TextBlock x:Name="DataDirText" FontSize="11" Foreground="#666666" TextWrapping="Wrap" LineHeight="16"/>
                        <StackPanel Orientation="Horizontal" Margin="0,8,0,0">
                            <Button Content="打开数据目录" Style="{StaticResource FluentButtonSecondary}"
                                    Padding="10,4" FontSize="12" Click="OnOpenDataDir"/>
                            <TextBlock x:Name="SizeText" FontSize="12" Foreground="#666666"
                                       VerticalAlignment="Center" Margin="10,0,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <TextBlock Text="实验性功能" FontWeight="SemiBold" Foreground="#1A1A1A" Margin="0,0,0,6"/>
                <Border Style="{StaticResource CardBorder}" Margin="0,0,0,4">
                    <StackPanel Margin="4">
                        <CheckBox x:Name="SyncCheck" Content="多端同步（实验性）"
                                  Style="{StaticResource FluentCheckBox}"/>
                        <TextBlock Text="开启后，本机复制的内容会经自建服务器同步到同一账号下的其他设备（手机），手机复制的内容会出现在本机历史中并标注“手机”来源。"
                                   FontSize="12" Foreground="#888888" TextWrapping="Wrap" LineHeight="18" Margin="0,4,0,0"/>
                        <StackPanel x:Name="SyncPanel" Margin="0,10,0,0" Visibility="Collapsed">
                            <TextBlock Text="账号" FontSize="12" Foreground="#888888" Margin="0,0,0,4"/>
                            <TextBox x:Name="SyncUserBox" Style="{StaticResource FluentTextBox}" Margin="0,0,0,8"/>
                            <TextBlock Text="密码" FontSize="12" Foreground="#888888" Margin="0,0,0,4"/>
                            <PasswordBox x:Name="SyncPassBox" Margin="0,0,0,8"/>
                            <TextBlock Text="设备名称（如：工作电脑）" FontSize="12" Foreground="#888888" Margin="0,0,0,4"/>
                            <TextBox x:Name="SyncDeviceBox" Style="{StaticResource FluentTextBox}" Margin="0,0,0,10"/>
                            <StackPanel Orientation="Horizontal">
                                <Button x:Name="SyncLoginBtn" Content="登录" Style="{StaticResource FluentButton}"
                                        Padding="14,5" FontSize="12" Click="OnSyncLogin"/>
                                <Button x:Name="SyncRegisterBtn" Content="注册" Style="{StaticResource FluentButtonSecondary}"
                                        Padding="14,5" FontSize="12" Margin="8,0,0,0" Click="OnSyncRegister"/>
                                <Button x:Name="SyncLogoutBtn" Content="退出登录" Style="{StaticResource FluentButtonSecondary}"
                                        Padding="14,5" FontSize="12" Margin="8,0,0,0" Click="OnSyncLogout" Visibility="Collapsed"/>
                            </StackPanel>
                            <TextBlock x:Name="SyncStatusText" FontSize="12" Foreground="#C55A11"
                                       TextWrapping="Wrap" LineHeight="18" Margin="0,8,0,0"/>
                        </StackPanel>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Style="{StaticResource FluentButtonSecondary}" Padding="16,6" Margin="0,0,10,0" IsCancel="True"/>
            <Button Content="确定" Style="{StaticResource FluentButton}" Padding="16,6" IsDefault="True" Click="OnOk"/>
        </StackPanel>
    </Grid>
</Window>
