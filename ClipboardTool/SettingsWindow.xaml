<Window x:Class="ClipboardTool.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="360" Height="320"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False">
    <StackPanel Margin="20">
        <TextBlock Text="全局热键" FontSize="13" Foreground="#444444" Margin="0,0,0,4"/>
        <TextBox x:Name="HotkeyBox" FontSize="13" Padding="6,4"
                 ToolTip="点击后按下新的组合键" Margin="0,0,0,14"/>

        <TextBlock Text="历史条数上限" FontSize="13" Foreground="#444444" Margin="0,0,0,4"/>
        <TextBox x:Name="MaxBox" FontSize="13" Padding="6,4" Margin="0,0,0,14"/>

        <CheckBox x:Name="AutoStartCheck" Content="开机自动启动" FontSize="13" Margin="0,0,0,8"/>
        <CheckBox x:Name="PlainCheck" Content="粘贴时默认去格式（纯文本）" FontSize="13" Margin="0,0,0,20"/>

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="取消" Padding="16,5" Margin="0,0,10,0" IsCancel="True"/>
            <Button Content="确定" Padding="16,5" IsDefault="True" Click="OnOk"/>
        </StackPanel>
    </StackPanel>
</Window>
