<Window x:Class="ClipboardTool.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="设置"
        Width="380" Height="340"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="#F3F3F3">
    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="全局热键" FontWeight="SemiBold" Foreground="#1A1A1A" Margin="0,0,0,6"/>
            <TextBlock Text="点击后按下新的组合键" FontSize="12" Foreground="#888888" Margin="0,0,0,4"/>
            <TextBox x:Name="HotkeyBox" Style="{StaticResource FluentTextBox}" Margin="0,0,0,16"/>

            <TextBlock Text="历史条数上限" FontWeight="SemiBold" Foreground="#1A1A1A" Margin="0,0,0,6"/>
            <TextBlock Text="范围 10 ~ 10000" FontSize="12" Foreground="#888888" Margin="0,0,0,4"/>
            <TextBox x:Name="MaxBox" Style="{StaticResource FluentTextBox}" Margin="0,0,0,16"/>

            <CheckBox x:Name="AutoStartCheck" Content="开机自动启动" Style="{StaticResource FluentCheckBox}"/>
            <CheckBox x:Name="PlainCheck" Content="粘贴时默认去格式（纯文本）" Style="{StaticResource FluentCheckBox}"/>
        </StackPanel>

        <StackPanel Grid.Row="1" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button Content="取消" Style="{StaticResource FluentButtonSecondary}" Padding="16,6" Margin="0,0,10,0" IsCancel="True"/>
            <Button Content="确定" Style="{StaticResource FluentButton}" Padding="16,6" IsDefault="True" Click="OnOk"/>
        </StackPanel>
    </Grid>
</Window>
