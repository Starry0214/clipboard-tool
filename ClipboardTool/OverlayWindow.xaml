<Window x:Class="ClipboardTool.OverlayWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClipboardTool"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        Width="440"
        SizeToContent="Height"
        MaxHeight="520"
        Focusable="True"
        SnapsToDevicePixels="True">
    <Window.Resources>
        <local:ThumbnailConverter x:Key="ThumbConverter"/>
    </Window.Resources>
    <Border CornerRadius="12"
            Background="White"
            BorderBrush="#D0D5DD"
            BorderThickness="1"
            Margin="10"
            Padding="0">
        <Border.Effect>
            <DropShadowEffect BlurRadius="24" ShadowDepth="2" Opacity="0.12" Color="#000000"/>
        </Border.Effect>
        <DockPanel>
            <!-- 搜索框 + 类型筛选 -->
            <Border DockPanel.Dock="Top"
                    Background="#F7F8FA"
                    CornerRadius="12,12,0,0"
                    Padding="12,8">
                <Grid>
                    <TextBlock Text="🔍 搜索历史"
                               FontSize="13"
                               Foreground="#888888"
                               VerticalAlignment="Center"
                               Visibility="{Binding Text.Length, ElementName=SearchBox, Converter={StaticResource StringToVisibility}}"/>
                    <TextBox x:Name="SearchBox"
                             BorderThickness="0"
                             Background="Transparent"
                             FontSize="13"
                             Foreground="#1A1A1A"
                             CaretBrush="{StaticResource AccentBrush}"
                             Padding="0,0,90,0">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Template">
                                    <Setter.Value>
                                        <ControlTemplate TargetType="TextBox">
                                            <ScrollViewer x:Name="PART_ContentHost"/>
                                        </ControlTemplate>
                                    </Setter.Value>
                                </Setter>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <!-- 类型筛选（自绘矢量图标，悬浮显示提示） -->
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <RadioButton x:Name="FilterAll" GroupName="TypeFilter"
                                     Style="{StaticResource FilterIconButton}" IsChecked="True"
                                     ToolTip="显示全部类型" Checked="OnFilterChanged">
                            <Grid Width="18" Height="18">
                                <Rectangle Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" RadiusX="1.5" RadiusY="1.5" Fill="Transparent"/>
                                <Line X1="9" Y1="2" X2="9" Y2="16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.4"/>
                                <Line X1="2" Y1="9" X2="16" Y2="9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.4"/>
                            </Grid>
                        </RadioButton>
                        <RadioButton x:Name="FilterText" GroupName="TypeFilter"
                                     Style="{StaticResource FilterIconButton}" Margin="6,0,0,0"
                                     ToolTip="只显示文本" Checked="OnFilterChanged">
                            <Grid Width="18" Height="22">
                                <Path Data="M 3 2 H 15 L 18 5 V 20 H 3 Z M 15 2 L 15 5 H 18"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.5" Fill="Transparent" StrokeLineJoin="Round"/>
                                <Line X1="6" Y1="8" X2="16" Y2="8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.4"/>
                                <Line X1="6" Y1="12" X2="14" Y2="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.4"/>
                                <Line X1="6" Y1="16" X2="11" Y2="16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.4"/>
                            </Grid>
                        </RadioButton>
                        <RadioButton x:Name="FilterImage" GroupName="TypeFilter"
                                     Style="{StaticResource FilterIconButton}" Margin="6,0,0,0"
                                     ToolTip="只显示图片" Checked="OnFilterChanged">
                            <Canvas Width="20" Height="20">
                                <Path Data="M 3 16 L 8 8 L 12 13 L 16 6 L 19 10 L 21 16 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.5" StrokeLineJoin="Round" Fill="Transparent"/>
                                <Ellipse Width="5" Height="5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.4" Fill="Transparent"
                                         Canvas.Left="13" Canvas.Top="1"/>
                            </Canvas>
                        </RadioButton>
                        <RadioButton x:Name="FilterFile" GroupName="TypeFilter"
                                     Style="{StaticResource FilterIconButton}" Margin="6,0,0,0"
                                     ToolTip="只显示文件" Checked="OnFilterChanged">
                            <Grid Width="22" Height="18">
                                <Path Data="M 2 6 L 9 6 L 11 3 L 20 3 L 20 16 L 2 16 Z"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.5" StrokeLineJoin="Round" Fill="Transparent"/>
                                <Line X1="2" Y1="16" X2="20" Y2="16"
                                      Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                      StrokeThickness="1.5"/>
                            </Grid>
                        </RadioButton>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- 分隔线 -->
            <Separator DockPanel.Dock="Top" Background="#E8E8E8" Margin="12,0"/>

            <!-- 历史列表 -->
            <ListBox x:Name="HistoryList"
                     BorderThickness="0"
                     Background="Transparent"
                     Padding="6,6"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Padding" Value="10,8"/>
                        <Setter Property="Margin" Value="0,1"/>
                        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                        <Setter Property="Cursor" Value="Hand"/>
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem">
                                    <Grid>
                                        <Border x:Name="Bd"
                                                Background="Transparent"
                                                CornerRadius="8"
                                                Padding="{TemplateBinding Padding}">
                                            <ContentPresenter/>
                                        </Border>
                                        <!-- 条目间分隔线 -->
                                        <Rectangle Height="1" Fill="#ECECEC"
                                                   VerticalAlignment="Bottom" Margin="10,0"/>
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <Trigger Property="IsSelected" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#E8F0FE"/>
                                        </Trigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Bd" Property="Background" Value="#F5F7FA"/>
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid x:Name="Root" MinHeight="32">
                            <!-- 右键快捷菜单：置顶 / 删除 / 预览 / 粘贴 -->
                            <Grid.ContextMenu>
                                <ContextMenu Style="{StaticResource FluentContextMenu}"
                                             Opened="OnContextMenuOpened" Closed="OnContextMenuClosed">
                                    <ContextMenu.Resources>
                                        <Style TargetType="MenuItem" BasedOn="{StaticResource FluentMenuItem}"/>
                                        <Style TargetType="Separator" BasedOn="{StaticResource FluentMenuSeparator}"/>
                                    </ContextMenu.Resources>
                                    <MenuItem Header="置顶" Click="OnPin"/>
                                    <MenuItem Header="删除" Click="OnDelete"/>
                                    <Separator/>
                                    <MenuItem Header="预览" Click="OnPreview"/>
                                    <MenuItem Header="粘贴" Click="OnPaste"/>
                                </ContextMenu>
                            </Grid.ContextMenu>
                            <!-- 图片条目：缩略图 -->
                            <StackPanel x:Name="ImagePanel" Orientation="Horizontal" Visibility="Collapsed">
                                <Border CornerRadius="6" ClipToBounds="True" BorderBrush="#E8E8E8" BorderThickness="1">
                                    <Image Source="{Binding Thumb, Converter={StaticResource ThumbConverter}}"
                                           Stretch="Uniform"
                                           SnapsToDevicePixels="True"/>
                                </Border>
                            </StackPanel>
                            <!-- 文件条目：图标 + 路径（两行换行完整显示） -->
                            <StackPanel x:Name="FilePanel" Orientation="Horizontal" Visibility="Collapsed">
                                <Border Background="#E8F0FE" CornerRadius="6" Width="32" Height="32"
                                        Margin="0,0,10,0" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE8B7;"
                                               FontSize="15"
                                               Foreground="#0078D4"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding Content}"
                                           TextWrapping="Wrap"
                                           LineHeight="19"
                                           MaxHeight="38"
                                           MaxWidth="300"
                                           FontSize="13"
                                           Foreground="#1A1A1A"
                                           VerticalAlignment="Center"/>
                            </StackPanel>
                            <!-- 文本条目：两行截断，全文见 ToolTip / 双击预览 -->
                            <TextBlock x:Name="TextLine"
                                       Text="{Binding Content}"
                                       TextWrapping="Wrap"
                                       LineHeight="19"
                                       MaxHeight="38"
                                       MaxWidth="370"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="13"
                                       Foreground="#1A1A1A"
                                       VerticalAlignment="Center"/>
                            <!-- 置顶角标 -->
                            <Border x:Name="PinBadge" Visibility="Collapsed"
                                    Background="#E8F0FE" CornerRadius="4" Padding="4,2"
                                    HorizontalAlignment="Right" VerticalAlignment="Top"
                                    Margin="0,0,4,0">
                                <TextBlock Text="置顶" FontSize="10" Foreground="#0078D4" FontWeight="SemiBold"/>
                            </Border>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Type}" Value="image">
                                <Setter TargetName="ImagePanel" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="TextLine" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="FilePanel" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="file">
                                <Setter TargetName="FilePanel" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="TextLine" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="ImagePanel" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Pinned}" Value="True">
                                <Setter TargetName="PinBadge" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </DockPanel>
    </Border>
</Window>
