<Window x:Class="ClipboardTool.ErrorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="出错了"
        Width="480" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F3F3F3"
        Icon="{StaticResource AppIcon}">
    <Border Style="{StaticResource CardBorder}" Margin="16">
        <StackPanel Margin="4">
            <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Foreground="#1A1A1A" Margin="0,0,0,8"/>
            <TextBox x:Name="DetailBox"
                     IsReadOnly="True" TextWrapping="Wrap"
                     MaxHeight="180" VerticalScrollBarVisibility="Auto"
                     Background="#FAFAFA" BorderBrush="#E0E0E0" BorderThickness="1"
                     Padding="10" FontSize="12" Foreground="#444444"/>
            <TextBlock Text="点击“上报日志”可将日志发送给开发者（不包含剪贴板内容），便于排查问题。"
                       FontSize="11" Foreground="#888888" TextWrapping="Wrap" Margin="0,8,0,10"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="BtnClose" Content="关闭" Style="{StaticResource FluentButtonSecondary}"
                        Padding="16,6" Margin="0,0,8,0" Click="OnClose"/>
                <Button x:Name="BtnUpload" Content="上报日志" Style="{StaticResource FluentButton}"
                        Padding="16,6" Click="OnUpload"/>
            </StackPanel>
        </StackPanel>
    </Border>
</Window>
