<Window x:Class="ClipboardTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClipboardTool"
        Title="剪贴板助手 — 历史记录"
        Width="520" Height="560"
        MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterScreen"
        Background="#F3F3F3"
        Icon="{StaticResource AppIcon}">
    <Window.Resources>
        <local:ThumbnailConverter x:Key="ThumbConverter"/>
    </Window.Resources>
    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 顶部搜索栏 -->
        <Border Grid.Row="0" Style="{StaticResource CardBorder}" Margin="0,0,0,12" Padding="12,8">
            <Grid>
                <TextBlock Text="🔍 搜索历史记录"
                           FontSize="13" Foreground="#888888"
                           VerticalAlignment="Center"
                           Visibility="{Binding Text.Length, ElementName=SearchBox, Converter={StaticResource StringToVisibility}}"/>
                <TextBox x:Name="SearchBox"
                         BorderThickness="0" Background="Transparent" FontSize="13"
                         VerticalContentAlignment="Center" Margin="-4,0" Padding="0,0,96,0"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <RadioButton x:Name="FilterAll" GroupName="TypeFilter"
                                 Style="{StaticResource FilterIconButton}" IsChecked="True"
                                 ToolTip="显示全部类型" Checked="OnFilterChanged">
                        <Grid Width="18" Height="18">
                            <Rectangle Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.6" RadiusX="1.5" RadiusY="1.5" Fill="Transparent"/>
                            <Line X1="9" Y1="2" X2="9" Y2="16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.4"/>
                            <Line X1="2" Y1="9" X2="16" Y2="9" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.4"/>
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="FilterText" GroupName="TypeFilter"
                                 Style="{StaticResource FilterIconButton}" Margin="6,0,0,0"
                                 ToolTip="只显示文本" Checked="OnFilterChanged">
                        <Grid Width="18" Height="22">
                            <Path Data="M 3 2 H 15 L 18 5 V 20 H 3 Z M 15 2 L 15 5 H 18"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.5" Fill="Transparent" StrokeLineJoin="Round"/>
                            <Line X1="6" Y1="8" X2="16" Y2="8" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.4"/>
                            <Line X1="6" Y1="12" X2="14" Y2="12" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.4"/>
                            <Line X1="6" Y1="16" X2="11" Y2="16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.4"/>
                        </Grid>
                    </RadioButton>
                    <RadioButton x:Name="FilterImage" GroupName="TypeFilter"
                                 Style="{StaticResource FilterIconButton}" Margin="6,0,0,0"
                                 ToolTip="只显示图片" Checked="OnFilterChanged">
                        <Canvas Width="20" Height="20">
                            <Path Data="M 3 16 L 8 8 L 12 13 L 16 6 L 19 10 L 21 16 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.5" StrokeLineJoin="Round" Fill="Transparent"/>
                            <Ellipse Width="5" Height="5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}" StrokeThickness="1.4" Fill="Transparent"
                                     Canvas.Left="13" Canvas.Top="1"/>
                        </Canvas>
                    </RadioButton>
                    <RadioButton x:Name="FilterFile" GroupName="TypeFilter"
                                 Style="{StaticResource FilterIconButton}" Margin="6,0,0,0"
                                 ToolTip="只显示文件" Checked="OnFilterChanged">
                        <Grid Width="22" Height="18">
                            <Path Data="M 2 6 L 9 6 L 11 3 L 20 3 L 20 16 L 2 16 Z"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.5" StrokeLineJoin="Round" Fill="Transparent"/>
                            <Line X1="2" Y1="16" X2="20" Y2="16"
                                  Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=RadioButton}}"
                                  StrokeThickness="1.5"/>
                        </Grid>
                    </RadioButton>
                    <Rectangle Width="1" Height="16" Fill="#DDDDDD" Margin="8,0"/>
                    <!-- 来源筛选：单图标三态（全部/手机/电脑），单击循环切换，右键菜单直接选择 -->
                    <Border x:Name="SourceFilterPanel" Background="#F0F1F3" CornerRadius="7" Padding="2" Visibility="Collapsed">
                        <Button x:Name="SourceFilterBtn" Style="{StaticResource SourceFilterBtnStyle}"
                                ToolTip="全部来源 — 单击切换（全部→手机→电脑），右键直接选择"
                                Click="OnSourceFilterCycle" Padding="2,0">
                            <Button.ContextMenu>
                                <ContextMenu Style="{StaticResource FluentContextMenu}" Opened="OnSourceMenuOpened">
                                    <ContextMenu.Resources>
                                        <Style TargetType="MenuItem" BasedOn="{StaticResource FluentMenuItem}"/>
                                        <Style TargetType="Separator" BasedOn="{StaticResource FluentMenuSeparator}"/>
                                    </ContextMenu.Resources>
                                    <MenuItem x:Name="SourceMenuAll" Header="显示全部来源" Tag="all" Click="OnSourceMenuSelect"/>
                                    <MenuItem x:Name="SourceMenuLocal" Header="只看本机复制" Tag="local" Click="OnSourceMenuSelect"/>
                                    <MenuItem x:Name="SourceMenuPhone" Header="只看手机同步" Tag="phone" Click="OnSourceMenuSelect"/>
                                </ContextMenu>
                            </Button.ContextMenu>
                            <Grid Width="24" Height="20">
                                <Grid x:Name="SourceIconAll" Visibility="Visible">
                                    <!-- 手机 Path（左侧，x=2-7, y=3-15） -->
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Fill="Transparent" Stretch="None" StrokeLineJoin="Round"
                                          Data="M 3,3 H 6 Q 7,3 7,4 V 13 Q 7,14 6,14 H 3 Q 2,14 2,13 V 4 Q 2,3 3,3 Z M 3.5,12 H 5.5"/>
                                    <!-- 中间分隔竖线（x=10） -->
                                    <Line X1="10" Y1="3" X2="10" Y2="17" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/>
                                    <!-- 显示器 Path（右侧，x=13-22, y=4-14 + 支架底座） -->
                                    <Path Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" Fill="Transparent" Stretch="None" StrokeLineJoin="Round"
                                          Data="M 14,4 H 21 Q 22,4 22,5 V 11 Q 22,12 21,12 H 14 Q 13,12 13,11 V 5 Q 13,4 14,4 Z M 17.5,12 V 14.5 M 15,14.5 H 20"/>
                                </Grid>
                                <Grid x:Name="SourceIconPhone" Visibility="Collapsed">
                                    <Rectangle Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" RadiusX="2" RadiusY="2" Width="10" Height="17" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                    <Line X1="10" Y1="16" X2="14" Y2="16" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.2"/>
                                </Grid>
                                <Grid x:Name="SourceIconLocal" Visibility="Collapsed">
                                    <!-- 显示器：宽屏+支架+底座（原始粗细） -->
                                    <Rectangle Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5" RadiusX="1" RadiusY="1" Width="18" Height="11" Fill="Transparent" HorizontalAlignment="Center" VerticalAlignment="Top" Margin="0,1,0,0"/>
                                    <Line X1="12" Y1="12" X2="12" Y2="15.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.4"/>
                                    <Line X1="8" Y1="15.5" X2="16" Y2="15.5" Stroke="{Binding Foreground, RelativeSource={RelativeSource AncestorType=Button}}" StrokeThickness="1.5"/>
                                </Grid>
                            </Grid>
                        </Button>
                    </Border>
                </StackPanel>
            </Grid>
        </Border>

        <!-- 历史列表 -->
        <Border Grid.Row="1" Style="{StaticResource CardBorder}" Padding="8" Margin="0,0,0,12">
            <ListBox x:Name="HistoryList"
                     BorderThickness="0"
                     Background="Transparent"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                     VirtualizingPanel.IsVirtualizing="True"
                     VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem" BasedOn="{StaticResource FluentListBoxItem}"/>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Grid x:Name="Root" MinHeight="30">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <!-- 来源/置顶标签：内容左侧竖直排布，不遮挡文本（原右上角悬浮会盖住文字） -->
                            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,8,0">
                                <Border x:Name="SourceBadge" Visibility="Collapsed"
                                        Background="#FFF4E5" CornerRadius="4" Padding="4,2"
                                        Margin="0,0,4,0" VerticalAlignment="Center">
                                    <TextBlock Text="手机" FontSize="10" Foreground="#C55A11" FontWeight="SemiBold"/>
                                </Border>
                                <Border x:Name="PinBadge" Visibility="Collapsed"
                                        Background="#E8F0FE" CornerRadius="4" Padding="4,2"
                                        VerticalAlignment="Center">
                                    <TextBlock Text="置顶" FontSize="10" Foreground="#0078D4" FontWeight="SemiBold"/>
                                </Border>
                            </StackPanel>
                            <!-- 图片条目：缩略图 -->
                            <StackPanel Grid.Column="1" x:Name="ImagePanel" Orientation="Horizontal" Visibility="Collapsed">
                                <Border CornerRadius="6" ClipToBounds="True" BorderBrush="#E8E8E8" BorderThickness="1">
                                    <Image Source="{Binding Thumb, Converter={StaticResource ThumbConverter}}"
                                           Stretch="Uniform"/>
                                </Border>
                            </StackPanel>
                            <!-- 文件条目：图标 + 路径（两行换行完整显示） -->
                            <StackPanel Grid.Column="1" x:Name="FilePanel" Orientation="Horizontal" Visibility="Collapsed">
                                <Border Background="#E8F0FE" CornerRadius="6" Width="28" Height="28"
                                        Margin="0,0,8,0" VerticalAlignment="Center">
                                    <TextBlock FontFamily="Segoe MDL2 Assets"
                                               Text="&#xE8B7;" FontSize="14"
                                               Foreground="#0078D4"
                                               HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                </Border>
                                <TextBlock Text="{Binding Content}"
                                           TextWrapping="Wrap" LineHeight="19" MaxHeight="38" MaxWidth="300"
                                           FontSize="13" VerticalAlignment="Center" Foreground="#1A1A1A"/>
                            </StackPanel>
                            <TextBlock Grid.Column="1" x:Name="TextLine"
                                       Text="{Binding DisplayContent}"
                                       TextWrapping="Wrap"
                                       LineHeight="19"
                                       MaxHeight="38"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="13" VerticalAlignment="Center" Foreground="#1A1A1A"/>
                        </Grid>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding Type}" Value="image">
                                <Setter TargetName="ImagePanel" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="TextLine" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="FilePanel" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Type}" Value="file">
                                <Setter TargetName="FilePanel" Property="Visibility" Value="Visible"/>
                                <Setter TargetName="TextLine" Property="Visibility" Value="Collapsed"/>
                                <Setter TargetName="ImagePanel" Property="Visibility" Value="Collapsed"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Pinned}" Value="True">
                                <Setter TargetName="PinBadge" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                            <DataTrigger Binding="{Binding Source}" Value="phone">
                                <Setter TargetName="SourceBadge" Property="Visibility" Value="Visible"/>
                            </DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Border>

        <!-- 底部操作栏：左侧当前版本号，右侧操作按钮 -->
        <Grid Grid.Row="2">
            <TextBlock x:Name="VersionText" FontSize="11" Foreground="#999999"
                       VerticalAlignment="Center" HorizontalAlignment="Left"/>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="置顶" Style="{StaticResource FluentButtonSecondary}" Margin="0,0,8,0" Padding="12,6" Click="OnPin"/>
                <Button Content="删除" Style="{StaticResource FluentButtonSecondary}" Margin="0,0,8,0" Padding="12,6" Click="OnDelete"/>
                <Button Content="清空" Style="{StaticResource FluentButtonSecondary}" Margin="0,0,8,0" Padding="12,6" Click="OnClear"/>
                <Button Content="设置" Style="{StaticResource FluentButtonSecondary}" Margin="0,0,8,0" Padding="12,6" Click="OnSettings"/>
                <Button Content="刷新" Style="{StaticResource FluentButton}" Padding="12,6" Click="OnRefresh"/>
            </StackPanel>
        </Grid>
    </Grid>
</Window>
