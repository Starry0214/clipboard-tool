<Window x:Class="ClipboardTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:local="clr-namespace:ClipboardTool"
        Title="剪贴板工具 - 历史记录"
        Width="520" Height="560"
        MinWidth="420" MinHeight="360"
        WindowStartupLocation="CenterScreen">
    <Window.Resources>
        <local:ThumbnailConverter x:Key="ThumbConverter"/>
    </Window.Resources>
    <DockPanel Margin="12">
        <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
            <Border Background="#EDEFF2" CornerRadius="6" Padding="8,4" DockPanel.Dock="Left">
                <TextBox x:Name="SearchBox" Width="300"
                         BorderThickness="0" Background="Transparent" FontSize="13"
                         VerticalContentAlignment="Center">
                    <TextBox.Style>
                        <Style TargetType="TextBox">
                            <Setter Property="Template">
                                <Setter.Value>
                                    <ControlTemplate TargetType="TextBox">
                                        <ScrollViewer x:Name="PART_ContentHost"/>
                                    </ControlTemplate>
                                </Setter.Value>
                            </Setter>
                        </Style>
                    </TextBox.Style>
                </TextBox>
            </Border>
        </DockPanel>

        <ListBox x:Name="HistoryList"
                 BorderBrush="#D9DCE1" BorderThickness="1"
                 ScrollViewer.HorizontalScrollBarVisibility="Disabled"
                 VirtualizingPanel.IsVirtualizing="True"
                 VirtualizingPanel.VirtualizationMode="Recycling">
            <ListBox.ItemContainerStyle>
                <Style TargetType="ListBoxItem">
                    <Setter Property="Padding" Value="8,7"/>
                    <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="ListBoxItem">
                                <Border x:Name="Bd"
                                        Background="{TemplateBinding Background}"
                                        CornerRadius="5"
                                        Padding="{TemplateBinding Padding}">
                                    <ContentPresenter/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="#DCE9F7"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </ListBox.ItemContainerStyle>
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid MinHeight="26">
                        <StackPanel x:Name="ImagePanel" Orientation="Horizontal" Visibility="Collapsed">
                            <Image Source="{Binding Thumb, Converter={StaticResource ThumbConverter}}"
                                   MaxWidth="180" MaxHeight="90" Stretch="Uniform"/>
                        </StackPanel>
                        <StackPanel x:Name="FilePanel" Orientation="Horizontal" Visibility="Collapsed">
                            <TextBlock FontFamily="Segoe MDL2 Assets"
                                       Text="&#xE8B7;" FontSize="15"
                                       Foreground="#60666E" VerticalAlignment="Center"
                                       Margin="0,0,8,0"/>
                            <TextBlock Text="{Binding Content}" TextTrimming="CharacterEllipsis"
                                       FontSize="13" VerticalAlignment="Center"/>
                        </StackPanel>
                        <TextBlock x:Name="TextLine"
                                   Text="{Binding Content}" TextTrimming="CharacterEllipsis"
                                   FontSize="13" VerticalAlignment="Center"/>
                        <Border x:Name="PinBadge" Visibility="Collapsed"
                                Background="#E8F0FE" CornerRadius="3" Padding="4,1"
                                HorizontalAlignment="Right" VerticalAlignment="Top"
                                Margin="0,0,4,0">
                            <TextBlock Text="置顶" FontSize="10" Foreground="#1A73E8"/>
                        </Border>
                    </Grid>
                    <DataTemplate.Triggers>
                        <DataTrigger Binding="{Binding Type}" Value="image">
                            <Setter TargetName="ImagePanel" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="TextLine" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Type}" Value="file">
                            <Setter TargetName="FilePanel" Property="Visibility" Value="Visible"/>
                            <Setter TargetName="TextLine" Property="Visibility" Value="Collapsed"/>
                        </DataTrigger>
                        <DataTrigger Binding="{Binding Pinned}" Value="True">
                            <Setter TargetName="PinBadge" Property="Visibility" Value="Visible"/>
                        </DataTrigger>
                    </DataTemplate.Triggers>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="0,8,0,0">
            <Button x:Name="BtnPin" Content="置顶 / 取消置顶" Padding="10,5" Margin="0,0,8,0" Click="OnPin"/>
            <Button x:Name="BtnDelete" Content="删除选中" Padding="10,5" Margin="0,0,8,0" Click="OnDelete"/>
            <Button Content="清空全部" Padding="10,5" Margin="0,0,8,0" Click="OnClear"/>
            <Button Content="设置" Padding="10,5" Margin="0,0,8,0" Click="OnSettings"/>
            <Button Content="刷新" Padding="10,5" Click="OnRefresh"/>
        </StackPanel>
    </DockPanel>
</Window>
