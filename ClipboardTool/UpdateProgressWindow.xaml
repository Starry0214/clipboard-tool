<Window x:Class="ClipboardTool.UpdateProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="正在下载更新"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="#F3F3F3"
        Icon="{StaticResource AppIcon}">
    <Border Style="{StaticResource CardBorder}" Margin="16">
        <StackPanel Margin="4">
            <TextBlock Text="正在下载新版本…" FontSize="14" FontWeight="SemiBold" Foreground="#1A1A1A" Margin="0,0,0,10"/>
            <ProgressBar x:Name="Bar" Height="8" Minimum="0" Maximum="100"
                         Foreground="#0078D4" Background="#E0E0E0" BorderThickness="0"/>
            <TextBlock x:Name="StatusText" Text="准备连接…" FontSize="12" Foreground="#444444" Margin="0,8,0,0"/>
            <TextBlock x:Name="SpeedText" Text="" FontSize="12" Foreground="#888888" Margin="0,2,0,0"/>
        </StackPanel>
    </Border>
</Window>
