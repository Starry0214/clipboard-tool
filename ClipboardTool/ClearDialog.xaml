<Window x:Class="ClipboardTool.ClearDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:shell="clr-namespace:System.Windows.Shell;assembly=PresentationFramework"
        Title="清空历史"
        Width="420" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Icon="{StaticResource AppIcon}">
    <shell:WindowChrome.WindowChrome>
        <shell:WindowChrome CaptionHeight="44" ResizeBorderThickness="0"
                            GlassFrameThickness="0" CornerRadius="0"
                            UseAeroCaptionButtons="False"/>
    </shell:WindowChrome.WindowChrome>
    <Border Background="{StaticResource CardBrush}"
            BorderBrush="#E8E8E8"
            BorderThickness="1" CornerRadius="14" Margin="10">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="4" Opacity="0.28" Color="#000000"/>
        </Border.Effect>
        <Grid>
            <Button Content="&#xE8BB;" Style="{StaticResource FluentButtonSecondary}"
                    Width="30" Height="30" Padding="0"
                    HorizontalAlignment="Right" VerticalAlignment="Top"
                    Margin="0,8,10,0" Click="OnCloseClick"
                    ToolTip="关闭"/>
            <StackPanel Margin="20,16,20,20">
                <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                    <Border Width="36" Height="36" CornerRadius="18"
                            Background="#C42B1C" VerticalAlignment="Center">
                        <TextBlock Text="&#xE8F1;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                                   Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="清空历史" FontWeight="SemiBold"
                               Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"
                               Margin="10,0,0,0" VerticalAlignment="Center"/>
                </StackPanel>
                <TextBlock x:Name="HintText" FontSize="12"
                           Foreground="{StaticResource TextSecondaryBrush}"
                           TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,16"/>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="本机清空" Style="{StaticResource FluentButtonSecondary}" Padding="14,6" Click="OnLocalClear"/>
                    <Button x:Name="FullClearBtn" Content="彻底清空（多端）" Style="{StaticResource DangerButton}" Padding="14,6" Margin="8,0,0,0" Click="OnFullClear"/>
                    <Button Content="取消" Style="{StaticResource FluentButtonSecondary}" Padding="14,6" Margin="8,0,0,0" IsCancel="True"/>
                </StackPanel>
            </StackPanel>
        </Grid>
    </Border>
</Window>
