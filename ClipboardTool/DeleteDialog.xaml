<Window x:Class="ClipboardTool.DeleteDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="删除"
        Width="400" SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        ShowInTaskbar="False"
        Background="{StaticResource WindowBgBrush}"
        Icon="{StaticResource AppIcon}">
    <StackPanel Margin="20">
        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
            <Border Width="36" Height="36" CornerRadius="18"
                    Background="#C42B1C" VerticalAlignment="Center">
                <TextBlock Text="&#xE74D;" FontFamily="Segoe MDL2 Assets" FontSize="18"
                           Foreground="White" HorizontalAlignment="Center" VerticalAlignment="Center"/>
            </Border>
            <TextBlock Text="选择删除方式" FontWeight="SemiBold"
                       Foreground="{StaticResource TextPrimaryBrush}" FontSize="14"
                       Margin="10,0,0,0" VerticalAlignment="Center"/>
        </StackPanel>
        <TextBlock x:Name="HintText" FontSize="12"
                   Foreground="{StaticResource TextSecondaryBrush}"
                   TextWrapping="Wrap" LineHeight="18" Margin="0,0,0,16"/>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="本地删除" Style="{StaticResource FluentButtonSecondary}" Padding="14,6" Click="OnLocalDelete"/>
            <Button x:Name="FullDeleteBtn" Content="彻底删除" Style="{StaticResource DangerButton}" Padding="14,6" Margin="8,0,0,0" Click="OnFullDelete"/>
            <Button Content="取消" Style="{StaticResource FluentButtonSecondary}" Padding="14,6" Margin="8,0,0,0" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
